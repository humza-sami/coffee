# Runs first during `cmake --install`. Refuses (before writing anything) when
#  * any destination, including the manifest itself, exists and is not an unmodified regular file recorded in this prefix's own
#    manifest (the manifest is "ours" only if it is a regular file with recognized v1 entries and matching installed ownership anchors), or
#  * any directory below the prefix on the way to a destination is a symlink (installation never follows one).
# The prefix itself may be a symlink: it is the anchor the user chose. COFFEE_INSTALL_FILES is injected by cmake/Install.cmake.
set(_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_manifest_rel "share/coffee/install-manifest.txt")
set(_manifest "${_root}/${_manifest_rel}")
set(_conflicts "")

# Check directory components before reading a manifest or hashing destinations.
# Existing non-directories must also be rejected here, before CMake can write earlier files.
foreach(_rel IN LISTS COFFEE_INSTALL_FILES _manifest_rel)
  get_filename_component(_parent "${_rel}" DIRECTORY)
  string(REPLACE "/" ";" _parts "${_parent}")
  set(_cur "${_root}")
  foreach(_part IN LISTS _parts)
    set(_cur "${_cur}/${_part}")
    if(IS_SYMLINK "${_cur}")
      list(APPEND _conflicts "${_rel} (parent directory '${_cur}' is a symbolic link)")
      break()
    elseif(EXISTS "${_cur}" AND NOT IS_DIRECTORY "${_cur}")
      list(APPEND _conflicts "${_rel} (parent '${_cur}' is not a directory)")
      break()
    endif()
  endforeach()
endforeach()
if(_conflicts)
  string(JOIN "\n  " _msg ${_conflicts})
  message(FATAL_ERROR "coffee: refusing to install into '${_root}': nothing was written.\n  ${_msg}")
endif()

# 1. the manifest: absent, or a regular (non-symlink) file in the exact format we write
set(_owned "")
if(IS_SYMLINK "${_manifest}")
  list(APPEND _conflicts "${_manifest_rel} (is a symbolic link; refusing to write through it)")
elseif(EXISTS "${_manifest}")
  if(IS_DIRECTORY "${_manifest}")
    list(APPEND _conflicts "${_manifest_rel} (is a directory)")
  else()
    file(STRINGS "${_manifest}" _lines)
    set(_ok TRUE)
    if(NOT _lines)
      set(_ok FALSE)
    else()
      list(GET _lines 0 _first)
      if(NOT _first STREQUAL "# coffee install manifest v1")
        set(_ok FALSE)
      endif()
    endif()
    foreach(_l IN LISTS _lines)
      if(_l MATCHES "^#" OR _l STREQUAL "")
        continue()
      elseif(_l MATCHES "^([0-9a-f]+)  (.+)$")
        set(_digest "${CMAKE_MATCH_1}")  # copy first: later MATCHES calls overwrite CMAKE_MATCH_*
        set(_rel "${CMAKE_MATCH_2}")
        string(LENGTH "${_digest}" _dl)
        if(NOT _dl EQUAL 64 OR _rel MATCHES "^/" OR _rel MATCHES "(^|/)\\.\\.?(/|$)" OR _rel MATCHES "//|/$" OR _rel IN_LIST _owned)
          set(_ok FALSE)
        elseif(NOT _rel MATCHES "^(bin/coffee|share/coffee/uninstall\\.sh|share/coffee/(examples|systemd-user)/.+|share/doc/coffee/.+)$")
          set(_ok FALSE)
        else()
          set(_owned_${_rel} "${_digest}")
          list(APPEND _owned "${_rel}")
        endif()
      else()
        set(_ok FALSE)
      endif()
    endforeach()
    if(NOT _owned)
      set(_ok FALSE)
    endif()
    # Syntax alone does not establish ownership. Require both stable installation
    # anchors to exist and match their recorded bytes. Compare against the old
    # manifest, not this build, so an unmodified earlier release can be upgraded.
    set(_anchors_ok TRUE)
    foreach(_anchor bin/coffee share/coffee/uninstall.sh)
      set(_path "${_root}/${_anchor}")
      if(NOT _anchor IN_LIST _owned OR IS_SYMLINK "${_path}" OR NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
        set(_anchors_ok FALSE)
      else()
        file(SHA256 "${_path}" _anchor_digest)
        if(NOT _anchor_digest STREQUAL "${_owned_${_anchor}}")
          set(_anchors_ok FALSE)
        endif()
      endif()
    endforeach()
    if(NOT _anchors_ok)
      list(APPEND _conflicts "${_manifest_rel} (no matching installed binary and uninstaller; stale or foreign manifest: inspect and move it aside, or choose another prefix)")
    endif()
    if(NOT _ok)
      list(APPEND _conflicts "${_manifest_rel} (exists but is not a well-formed Coffee install manifest)")
      set(_owned "")
    endif()
  endif()
endif()

# 2. every destination, plus symlinked ancestors
foreach(_rel IN LISTS COFFEE_INSTALL_FILES _manifest_rel)
  if(_rel STREQUAL _manifest_rel)
    continue()  # judged above
  endif()
  set(_dest "${_root}/${_rel}")
  if(IS_SYMLINK "${_dest}" OR EXISTS "${_dest}")
    if(NOT IS_SYMLINK "${_dest}" AND NOT IS_DIRECTORY "${_dest}" AND _rel IN_LIST _owned)
      file(SHA256 "${_dest}" _have)
      if(_have STREQUAL "${_owned_${_rel}}")
        continue()
      endif()
      list(APPEND _conflicts "${_rel} (differs from the file this prefix's manifest recorded)")
    else()
      list(APPEND _conflicts "${_rel} (exists and was not installed by Coffee)")
    endif()
  endif()
endforeach()
if(_conflicts)
  list(REMOVE_DUPLICATES _conflicts)
  string(JOIN "\n  " _msg ${_conflicts})
  message(FATAL_ERROR "coffee: refusing to install into '${_root}': nothing was written.\n  ${_msg}\nRemove or move the existing path(s), or choose another --prefix.")
endif()
