# Install rules + packaging. `cmake --install build --prefix DIR` never overwrites a file it did not install itself
# (cmake/InstallGuard.cmake runs first) and records share/coffee/install-manifest.txt, which scripts/uninstall.sh follows.
# Pass 1 collects (source, relative destination directory) pairs; pass 2 registers guard, files, executable and manifest in order.
set(_coffee_pairs "")   # "src|reldir" entries

function(_coffee_add src reldir)
  list(APPEND _coffee_pairs "${src}|${reldir}")
  set(_coffee_pairs "${_coffee_pairs}" PARENT_SCOPE)
endfunction()

function(_coffee_add_tree srcdir reldir)
  file(GLOB_RECURSE _files RELATIVE "${srcdir}" CONFIGURE_DEPENDS "${srcdir}/*")
  foreach(_f IN LISTS _files)
    get_filename_component(_sub "${_f}" DIRECTORY)
    set(_dest "${reldir}")
    if(_sub)
      set(_dest "${reldir}/${_sub}")
    endif()
    list(APPEND _coffee_pairs "${srcdir}/${_f}|${_dest}")
  endforeach()
  set(_coffee_pairs "${_coffee_pairs}" PARENT_SCOPE)
endfunction()

set(_doc "share/doc/coffee")
foreach(_f README.md LICENSE NOTICE DEPENDENCIES.md CONTRIBUTING.md SECURITY.md)
  _coffee_add("${CMAKE_SOURCE_DIR}/${_f}" "${_doc}")
endforeach()
foreach(_f getting-started native-build native-protocol operations limitations benchmarking host-resources)
  _coffee_add("${CMAKE_SOURCE_DIR}/docs/${_f}.md" "${_doc}/docs")
endforeach()
_coffee_add("${CMAKE_SOURCE_DIR}/docs/releases/v${COFFEE_VERSION_FULL}.md" "${_doc}/docs/releases")
_coffee_add("${CMAKE_SOURCE_DIR}/docs/assets/coffee-terminal.gif" "${_doc}/docs/assets")
_coffee_add("${CMAKE_SOURCE_DIR}/docs/assets/coffee-roadmap.svg" "${_doc}/docs/assets")
_coffee_add_tree("${CMAKE_SOURCE_DIR}/third_party/licenses" "${_doc}/licenses")
_coffee_add_tree("${CMAKE_SOURCE_DIR}/examples" "share/coffee/examples")
_coffee_add_tree("${CMAKE_SOURCE_DIR}/packaging/systemd-user" "share/coffee/systemd-user")
_coffee_add("${CMAKE_SOURCE_DIR}/scripts/uninstall.sh" "share/coffee")

set(COFFEE_INSTALL_FILES "bin/coffee")
foreach(_p IN LISTS _coffee_pairs)
  string(REPLACE "|" ";" _parts "${_p}")
  list(GET _parts 0 _src)
  list(GET _parts 1 _dir)
  get_filename_component(_name "${_src}" NAME)
  list(APPEND COFFEE_INSTALL_FILES "${_dir}/${_name}")
endforeach()
string(JOIN ";" _list ${COFFEE_INSTALL_FILES})

install(CODE "set(COFFEE_INSTALL_FILES [==[${_list}]==])\nset(COFFEE_VERSION_FULL \"${COFFEE_VERSION_FULL}\")")
install(SCRIPT "${CMAKE_SOURCE_DIR}/cmake/InstallGuard.cmake")
install(TARGETS coffee RUNTIME DESTINATION bin)
foreach(_p IN LISTS _coffee_pairs)
  string(REPLACE "|" ";" _parts "${_p}")
  list(GET _parts 0 _src)
  list(GET _parts 1 _dir)
  if(_src MATCHES "uninstall\\.sh$")
    install(FILES "${_src}" DESTINATION "${_dir}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  else()
    install(FILES "${_src}" DESTINATION "${_dir}")
  endif()
endforeach()
install(SCRIPT "${CMAKE_SOURCE_DIR}/cmake/InstallManifest.cmake")

set(CPACK_PACKAGE_NAME "coffee")
set(CPACK_PACKAGE_VERSION "${COFFEE_VERSION_FULL}")
set(CPACK_PACKAGE_VENDOR "Coffee contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Coffee: owner-controlled task scheduling across Linux machines (Beta 1)")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_GENERATOR "TGZ")
set(CPACK_PACKAGE_FILE_NAME "coffee-${COFFEE_VERSION_FULL}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
set(CPACK_SET_DESTDIR OFF)
include(CPack)
